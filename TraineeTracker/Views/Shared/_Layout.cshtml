@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isDashboard = controller == "TraineeDashboard";
    var isLogin = controller == "Account" && action == "Login";
    var isAdminArea = controller == "Admin" || controller == "CurriculumImport";
    var roleCookie = Context.Request.Cookies[AppConstants.Cookies.Role];
    var demoRole = roleCookie == AppConstants.RoleValues.Mentor
        ? AppConstants.RoleValues.Mentor
        : roleCookie == AppConstants.RoleValues.Admin
            ? AppConstants.RoleValues.Admin
            : roleCookie == AppConstants.RoleValues.Trainee
                ? AppConstants.RoleValues.Trainee
                : (string?)null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="~/img/makandra_icon_white_color_rgb.svg" />
    <title>@ViewData["Title"] - TraineeTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@700;900&family=Open+Sans:wght@300..800&family=Source+Code+Pro&display=swap" rel="stylesheet">
    @if (!isDashboard)
    {
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/shared-ui.css" asp-append-version="true" />
        @if (!isLogin)
        {
            <link rel="stylesheet" href="~/css/app-navbar.css" asp-append-version="true" />
        }
        @if (isAdminArea)
        {
            <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
        }
        @if (isLogin)
        {
            <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
        }
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isAdminArea ? "admin-area" : "")">
    @Html.AntiForgeryToken()
    @if (isDashboard || isLogin)
    {
        @RenderBody()
    }
    else
    {
        <partial name="_AppNavbar" model='@(demoRole ?? AppConstants.RoleValues.Trainee)' />

        <header class="page-head">
            <div class="container">
                <div class="eyebrow">@ViewData["Eyebrow"]</div>
                <div class="accent-line"></div>
                <h1>@ViewData["Title"]</h1>
            </div>
        </header>

        <main>
            <div class="container">
                @RenderBody()
            </div>
        </main>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
