
<div id="pt-info-overlay" class="pt-info-overlay" hidden>
    <div class="pt-info-modal" role="dialog" aria-modal="true" aria-labelledby="pt-info-title">
        <button type="button" class="pt-info-close" aria-label="Info schließen">×</button>

        <div class="pt-info-eyebrow">Personentage</div>
        <h2 id="pt-info-title">PT-Konto</h2>
        <p>
            PT bedeutet Personentage. <strong>1 PT = 8 Arbeitsstunden.</strong>
            Das PT-Konto zeigt den aktuellen Lernfortschritt des Trainees.
        </p>

        <div class="pt-info-section">
            <h3>Kennzahlen</h3>
            <dl>
                <dt>Anwesend</dt>
                <dd>bisher am Lehrplan gearbeitete Personentage</dd>
                <dt>Geschafft</dt>
                <dd>gewichteter Fortschritt der relevanten Lektionen</dd>
                <dt>Offen</dt>
                <dd>restlicher relevanter Aufwand</dd>
                <dt>Puffer</dt>
                <dd>Geschafft minus Anwesend</dd>
                <dt>Geschwindigkeit</dt>
                <dd>Geschafft geteilt durch Anwesend</dd>
                <dt>Puffer-Prognose</dt>
                <dd>erwarteter Puffer am Ende</dd>
            </dl>
        </div>

        <div class="pt-info-section">
            <h3>Gewichtung</h3>
            <ul>
                <li><span>Open</span><strong>0 %</strong></li>
                <li><span>Started</span><strong>0 %</strong></li>
                <li><span>Finished</span><strong>70 %</strong></li>
                <li><span>Rejected</span><strong>80 %</strong></li>
                <li><span>Accepted</span><strong>100 %</strong></li>
                <li><span>Rated</span><strong>100 %</strong></li>
                <li><span>Skipped</span><strong>zählt nicht</strong></li>
            </ul>
        </div>
    </div>
</div>
